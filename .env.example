APP_ENV=development
PRODUCT_FACTORY_API_URL=http://API_HOST:8000
NEXT_PUBLIC_PRODUCT_NAME=造物工场
DATABASE_URL=postgresql+psycopg://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME
ARTIFACT_ROOT=/absolute/approved/path/artifacts
WORKSPACE_ROOT=/absolute/approved/path/workspaces
USER_SECRET_ROOT=/absolute/approved/path/user-secrets

MODEL_PROVIDER=deepseek
MODEL_NAME=
MODEL_BASE_URL=
MODEL_API_KEY_REF=DEEPSEEK_API_KEY
DEEPSEEK_API_KEY=

WEB_RESEARCH_PROVIDER=bocha
WEB_RESEARCH_BASE_URL=https://api.bochaai.com/v1
WEB_RESEARCH_API_KEY_REF=BOCHA_API_KEY
WEB_RESEARCH_TIMEOUT_SECONDS=30
BOCHA_API_KEY=

CODEX_CLI_PATH=/absolute/path/to/codex
CODEX_MAX_CONCURRENT_RUNS=1
CODEX_TASK_TIMEOUT_SECONDS=1800
AGENT_MAX_TURNS_PER_RUN=12
AGENT_MAX_RETRIES_PER_RUN=2
RUN_HEARTBEAT_TIMEOUT_SECONDS=90

INVITE_CODE_HASH=
SESSION_SECRET=
SESSION_TTL_SECONDS=28800
AUTH_ENFORCED=false

EVENT_STREAM_POLL_INTERVAL_SECONDS=0.5
EVENT_STREAM_HEARTBEAT_SECONDS=15
